# Chạy trên máy: chép file này thành .env rồi điền giá trị thật. Không commit .env.
# Trên Coolify: chỉ cần đặt ADMIN_USERNAME, ADMIN_PASSWORD và SESSION_SECRET ở tab Environment Variables, các mục còn lại đã có sẵn trong Dockerfile.

# Tài khoản super admin: có toàn quyền, thiết lập lần đầu, mở được dữ liệu và đặt lại mật khẩu của mọi người khi có người quên.
# Tên đăng nhập gồm chữ không dấu, số, dấu . _ @ -. Mật khẩu ít nhất 12 ký tự. Đổi hai giá trị này không ảnh hưởng dữ liệu.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Chuỗi ngẫu nhiên, ít nhất 32 ký tự. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Giữ nguyên sau khi đã dùng: chuỗi này tạo ra khóa để super admin mở dữ liệu. Đổi thì mọi người phải đăng nhập lại và cần mật khẩu chủ để gắn lại.
SESSION_SECRET=

PORT=3000
HOST=127.0.0.1

# Để 1 khi chạy sau proxy HTTPS. Chạy trực tiếp trên máy thì để 0.
TRUST_PROXY=0

# Nơi lưu dữ liệu. Để trống thì dùng data/payroll.db
# DB_FILE=/data/payroll.db
